{
    "expo": {
        "name": "Rest-Cat-v2",
        "slug": "Rest-Cat-v2",
        "version": "1.0.0",
        "owner": "restaurant-catalog-testers",
        "platforms": [
            "ios",
            "android"
        ],
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "restcatv2",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/expo.icon"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 76
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "3ea171c4-4d6d-43d5-8487-9534ffc931e5"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/3ea171c4-4d6d-43d5-8487-9534ffc931e5"
        }
    }
}